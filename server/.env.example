# Digital Hero — Backend Environment Variables (Server-only)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase Credentials (NEVER expose SUPABASE_SECRET_KEY to client or git)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key

# PostgreSQL Connection String (NEVER expose to client or git)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Stripe Test-Mode Configuration (Backend-only; NEVER expose to client or git)
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
STRIPE_MONTHLY_PRICE_ID=price_your_test_monthly_price_id
STRIPE_YEARLY_PRICE_ID=price_your_test_yearly_price_id
STRIPE_SUCCESS_URL=http://localhost:5173/subscription/success
STRIPE_CANCEL_URL=http://localhost:5173/onboarding/checkout
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret

# Payment Provider (Phase 1 Step 3+)
# Current: mock — no real Stripe calls, uses MockPaymentProvider
# Future:  stripe — switch to StripePaymentProvider in server/src/providers/payment/index.ts
PAYMENT_PROVIDER=mock
