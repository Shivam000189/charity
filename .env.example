# ==============================================================================
# DIGITAL HERO — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy backend variables into server/.env
# 2. Copy frontend variables into client/.env
# 3. Never commit real credentials or secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (server/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase Project API URL (In Supabase Project Settings > API > Project URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Secret Service Role Key (Backend ONLY — NEVER expose to frontend or git)
SUPABASE_SECRET_KEY=your_supabase_secret_service_role_key

# PostgreSQL Connection String (Backend ONLY — In Database Settings > Connection String)
# Remember to URL-encode special characters in password (e.g., # -> %23)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (client/.env)
# ------------------------------------------------------------------------------
# Public Supabase Project URL (Browser-safe)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Publishable / Anon Key (Browser-safe)
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Backend API Endpoint URL
VITE_API_URL=http://localhost:5000/api
